background = 0b0c16
foreground = ffffff
background-opacity = .95

# font-family = "SauceCodePro Nerd Font Mono"
# font-family = "SourceCodePro Nerd Font Mono"
font-family = "0xProto Nerd Font Mono"
font-feature = +ss01
# cursive for italics. Not sure I'm a fan.
# font-family-italic = "VictorMono Nerd Font Mono"
# font-family-bold-italic = "VictorMono Nerd Font Mono"
# font-family-italic = "RecMonoLinear Nerd Font Mono"
# font-family-bold-italic = "RecMonoLinear Nerd Font Mono"
font-size = 14
keybind = global:ctrl+grave_accent=toggle_quick_terminal
background-blur = 2
window-inherit-working-directory = false
tab-inherit-working-directory = true
cursor-color = #ff2070
auto-update-channel = tip
# custom shaders are killing battery. they were fun for a minute but ultimately not worth it.
# custom-shader = shaders/cursor-smear.glsl
# custom-shader = shaders/cursor_blaze.glsl

# bloom is super cool but it makes it hard to see powerline stuff. think about it later.
# custom-shader = shaders/bloom.glsl

quick-terminal-autohide = false
quick-terminal-screen = macos-menu-bar

# doesn't do anything for me.
# quick-terminal-size = 10%,100%
# quick-terminal-position = top

theme = 3024 Night
# theme = Kibble
# theme = 12-bit Rainbow
# theme = Citruszest

# palette = 11=#ffd75f

clipboard-trim-trailing-spaces = true
link-url = true
mouse-hide-while-typing = true
font-thicken = true
window-decoration = server
# window-decoration = none
window-theme = ghostty
macos-titlebar-proxy-icon = hidden
# macos-titlebar-style = hidden
# macos-icon = custom-style
# macos-icon-frame = plastic
# macos-icon-ghost-color = FFFFFF
# macos-icon-screen-color = 000000
progress-style = false

shell-integration-features = ssh-terminfo
